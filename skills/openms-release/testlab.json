{
  "configured": true,
  "kind": "github-workflow",
  "repo": "timosachsenberg/openms-test-lab",
  "workflow": "nightly-readiness.yml",
  "ref": "main",
  "mode": "lookup-or-dispatch",
  "inputs": {
    "openms_sha": "{sha}",
    "stage": "release"
  },
  "match_title": "{sha}",
  "timeout_minutes": 300,
  "poll_seconds": 600,
  "report_url": null,
  "command": null,
  "instructions": "Read gate.md of the Nightly readiness run for OpenMS {sha} ({version}) and report pass or fail, with the checks it left open."
}
